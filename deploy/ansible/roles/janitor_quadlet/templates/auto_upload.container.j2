[Unit]
Description=janitor auto_upload (tier 1)
After=network-online.target janitor-git_store.service janitor-bzr_store.service
Wants=network-online.target

[Container]
Image=ghcr.io/jelmer/janitor/auto_upload:latest
ContainerName=janitor-auto-upload
Network=host
# --listen-address 127.0.0.1 overrides the image's own baked-in
# --listen-address=0.0.0.0 (Dockerfile_auto_upload's ENTRYPOINT) - see
# worker.container.j2's own comment for why this needs overriding rather
# than an Entrypoint replacement, and why the override itself is safe
# (argparse keeps the last occurrence of a repeated flag). Reached only
# by other janitor services over loopback (Caddy doesn't proxy this
# one); nothing external needs this reachable beyond the host.
Exec=--listen-address 127.0.0.1 --config /mnt/janitor/janitor.conf{% if auto_upload_dput_host is defined %} --dput-host {{ auto_upload_dput_host }} --debsign-keyid {{ auto_upload_debsign_keyid }}{% endif %}
Volume={{ janitor_home }}:/mnt/janitor:rw
{% if auto_upload_dput_host is defined %}
# roles/auto_upload_target set these up - a local incoming directory and
# a signing key debsign can use, dput.cf pointed at that directory under
# the dput_host name above. dput reads /etc/dput.cf by default, no flag
# or env var needed. See docs/optional-services.md for how to enable this.
Volume={{ janitor_home }}/dput.cf:/etc/dput.cf:ro
Environment=GNUPGHOME=/mnt/janitor/gnupg
{% endif %}

# Already pulled this exact image explicitly in roles/janitor_source
# - never re-check the registry on every service start (quadlet's default
# for a :latest tag). That re-check was slow enough on this network to
# blow TimeoutStartSec below, failing the start outright even though the
# image was already present locally.
Pull=never

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=60

[Install]
WantedBy=default.target
