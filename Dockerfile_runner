ARG BUILD_BASE=ghcr.io/jelmer/janitor/build_base:latest
FROM ${BUILD_BASE} AS build
MAINTAINER Jelmer Vernooij <jelmer@jelmer.uk>

COPY . /code

RUN cargo build --release --manifest-path /code/runner/Cargo.toml --features gcp --bin janitor-runner

FROM docker.io/debian:testing-slim
MAINTAINER Jelmer Vernooij <jelmer@jelmer.uk>

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update --yes \
 && apt-get install --yes --no-install-recommends \
        auto-apt-proxy \
 && apt-get upgrade --yes \
 && apt-get satisfy --yes --no-install-recommends \
        ca-certificates \
        dpkg-dev \
        git \
        libpython3.14 \
        libssl3 \
        openssh-client \
        python3-breezy \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /code/target/release/janitor-runner /usr/local/bin/janitor-runner

EXPOSE 9911

EXPOSE 9919

ENTRYPOINT ["janitor-runner", "--port=9911",  "--public-port=9919", "--listen-address=0.0.0.0"]
