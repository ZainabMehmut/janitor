ARG BUILD_BASE=ghcr.io/jelmer/janitor/build_base:latest
FROM ${BUILD_BASE} AS build
MAINTAINER Jelmer Vernooij <jelmer@jelmer.uk>

COPY . /code

RUN cargo build --release --manifest-path /code/differ/Cargo.toml --bin janitor-differ

FROM docker.io/debian:testing-slim
MAINTAINER Jelmer Vernooij <jelmer@jelmer.uk>

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update --yes \
 && apt-get install --yes --no-install-recommends \
        auto-apt-proxy \
 && apt-get upgrade --yes \
 && apt-get satisfy --yes --no-install-recommends \
        ca-certificates \
        devscripts \
        diffoscope-minimal \
        libpython3.14 \
        libssl3 \
        python3-breezy \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /code/target/release/janitor-differ /usr/local/bin/janitor-differ

EXPOSE 9920

ENTRYPOINT ["janitor-differ", "--port=9920", "--listen-address=0.0.0.0"]
